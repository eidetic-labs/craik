$craik-brand: #7C72C7;

Screen {
    background: $background;
}

Screen > .screen--selection {
    background: #7C72C7;
    color: #FFFFFF;
}

#transcript {
    height: 1fr;
    padding: 1 1;
}

#slash-popup {
    dock: bottom;
    margin: 0 2 8 2;
    border: round #4A4A4A;
    height: auto;
    max-height: 12;
}

#working {
    dock: bottom;
    margin-bottom: 16;
    height: 1;
    color: $craik-brand;
}

#toast-queue {
    dock: bottom;
    margin: 0 2 15 2;
    color: #4A4A4A;
}

#accent-emission {
    color: $craik-brand;
}

#input {
    dock: bottom;
    border: round $craik-brand;
    margin-bottom: 3;
    height: 5;
    padding: 1 2;
}

.status-bar {
    color: #4A4A4A;
}

#footer-safe-area {
    height: 1;
}

.craik-modal {
    width: 72;
    max-width: 90%;
    height: auto;
    margin: 2 4;
    padding: 1 2;
    background: $surface;
    border: round $craik-brand;
}

.modal-title {
    text-style: bold;
    color: $craik-brand;
    margin-bottom: 1;
}

.modal-copy {
    margin-bottom: 1;
}

.modal-actions {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

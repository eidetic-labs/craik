$craik-brand: #B4ACE6;

Screen {
    background: $background;
}

#transcript {
    height: 1fr;
    padding: 1 1;
}

#slash-popup {
    dock: bottom;
    margin: 0 2 1 2;
    border: round #A0A0A0;
    height: auto;
    max-height: 12;
}

#history-search {
    dock: bottom;
    margin: 0 2 4 2;
    border: round #A0A0A0;
    height: auto;
    max-height: 8;
}

#working {
    color: $craik-brand;
}

#input {
    border: round $craik-brand;
}

#status {
    color: #A0A0A0;
}

.craik-modal {
    width: 72;
    max-width: 90%;
    height: auto;
    margin: 2 4;
    padding: 1 2;
    background: $surface;
    border: round $craik-brand;
}

.modal-title {
    text-style: bold;
    color: $craik-brand;
    margin-bottom: 1;
}

.modal-copy {
    margin-bottom: 1;
}

.modal-actions {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

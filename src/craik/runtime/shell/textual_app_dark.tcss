$craik-brand: #B4ACE6;

Screen {
    background: $background;
}

Screen > .screen--selection {
    background: #B4ACE6;
    color: #101010;
}

#transcript {
    height: 1fr;
    padding: 1 1;
}

#transcript-row-hint {
    dock: bottom;
    margin-bottom: 15;
    height: 1;
    color: #A0A0A0;
}

#run-activity {
    dock: bottom;
    margin: 0 1 8 1;
    height: 5;
}

#slash-popup {
    dock: bottom;
    margin: 0 2 8 2;
    border: round #A0A0A0;
    height: auto;
    max-height: 12;
}

#history-search {
    dock: bottom;
    margin: 0 2 8 2;
    border: round #A0A0A0;
    height: auto;
    max-height: 8;
}

#working {
    dock: bottom;
    margin-bottom: 16;
    height: 1;
    color: $craik-brand;
}

#toast-queue {
    dock: bottom;
    margin: 0 2 15 2;
    color: #A0A0A0;
}

#accent-emission {
    dock: bottom;
    margin-bottom: 2;
    height: 1;
    color: $craik-brand;
}

#input {
    dock: bottom;
    border: round $craik-brand;
    margin-bottom: 3;
    height: 5;
    padding: 1 2;
}

.status-bar {
    dock: bottom;
    margin-bottom: 1;
    height: 1;
    color: #A0A0A0;
}

#footer-safe-area {
    dock: bottom;
    height: 1;
}

.craik-modal {
    width: 72;
    max-width: 90%;
    height: auto;
    margin: 2 4;
    padding: 1 2;
    background: $surface;
    border: round $craik-brand;
}

.modal-title {
    text-style: bold;
    color: $craik-brand;
    margin-bottom: 1;
}

.modal-copy {
    margin-bottom: 1;
}

.modal-actions {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}
